<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NapMLS.UI.ViewModels"
             x:Class="NapMLS.UI.Views.ChatView"
             x:DataType="vm:ChatViewModel">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                Padding="16,12" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Button Content="← 返回"
                        Command="{Binding GoBackCommand}"
                        DockPanel.Dock="Left"
                        MinWidth="60" Height="32"
                        VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#E8F5E9" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="{Binding EncryptionStatus}" FontSize="11" Foreground="#2E7D32" />
                    </Border>
                    <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Epoch {0}">
                                <Binding Path="Epoch" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GroupName}" FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Input bar -->
        <Border DockPanel.Dock="Bottom" Padding="12,8"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <Button Content="发送"
                        Command="{Binding SendMessageCommand}"
                        DockPanel.Dock="Right"
                        MinWidth="80" Height="36"
                        IsEnabled="{Binding !IsSending}"
                        Margin="8,0,0,0" />
                <TextBox Text="{Binding InputText}"
                         PlaceholderText="输入消息..."
                         MinHeight="36"
                         KeyDown="TextBox_KeyDown" />
            </DockPanel>
        </Border>

        <!-- Messages -->
        <ItemsControl ItemsSource="{Binding Messages}" Margin="12,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MessageViewModel">
                    <Border CornerRadius="8" Padding="12,8" Margin="0,2"
                            Background="{Binding IsOwn, Converter={x:Static vm:OwnMessageBrushConverter.Instance}}">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding SenderName}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                           FontSize="11" Foreground="Gray" />
                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="Gray"
                                           IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Text="🔒" FontSize="11"
                                           IsVisible="{Binding IsEncrypted}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>

</UserControl>
