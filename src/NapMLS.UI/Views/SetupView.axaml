<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NapMLS.UI.ViewModels"
             x:Class="NapMLS.UI.Views.SetupView"
             x:DataType="vm:SetupViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="500" HorizontalAlignment="Center" Margin="32">

            <TextBlock Text="初始设置"
                       FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" />

            <TextBlock Text="NapCat 连接配置"
                       FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />

            <StackPanel Spacing="8">
                <TextBlock Text="WebSocket 地址" FontSize="14" />
                <TextBox Text="{Binding NapCatHost}" FontSize="14" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="端口" FontSize="14" />
                <TextBox Text="{Binding NapCatPort}" FontSize="14" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Token（可选）" FontSize="14" />
                <TextBox Text="{Binding NapCatToken}" FontSize="14" PlaceholderText="Bearer token" />
            </StackPanel>

            <TextBlock Text="身份信息"
                       FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />

            <Border Background="#F3E5F5" CornerRadius="8" Padding="16"
                    IsVisible="{Binding IsIdentityGenerated}">
                <StackPanel Spacing="8">
                    <TextBlock Text="安全码" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding MySafetyCode}"
                               FontSize="20" FontWeight="Bold"
                               FontFamily="Consolas,monospace"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="请将此安全码与对方进行比对验证"
                               FontSize="12" Foreground="Gray"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="14" Foreground="Gray"
                       HorizontalAlignment="Center" Margin="0,8" />

        </StackPanel>
    </ScrollViewer>

</UserControl>
